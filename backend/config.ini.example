# ---------------------------------------------------------------------------
# Webvirt configuration
#
# All configuration — OIDC settings and the list of hosts — lives in this one
# INI file. The backend reads it on startup and reloads it on SIGHUP or via
# POST /api/config/reload (no full restart needed).
#
# Adding or removing a host = editing the [hosts] block. There is no admin UI.
# ---------------------------------------------------------------------------

[oidc]
# Master toggle. Default is "true" (secure-by-default).
# Set to "false" ONLY on trusted internal networks where no login is desired.
# When false, the entire OIDC flow is skipped, no callback route is registered,
# and the dashboard is served unauthenticated. No logout button is shown.
enabled = true

issuer = https://keycloak.example.com/realms/example
client_id = my-client-id

# Omit this line entirely for public (PKCE) clients. For confidential clients
# this secret is used in the token exchange server-side only — never exposed
# to the frontend.
client_secret = my-client-secret

# "confidential" = Authorization Code + client_secret
# "public"        = Authorization Code + PKCE (S256), no secret anywhere
client_type = confidential

# Used verbatim as the redirect_uri in the auth request and as the path of the
# callback route. Never derived from the Host header — must match what the IdP
# has registered, byte-for-byte.
redirect_url = https://webvirt.example.com/oauth2/callback

# Fallback end-session endpoint used only if the discovery document does not
# expose an end_session_endpoint. RP-initiated logout passes id_token_hint and
# post_logout_redirect_uri (derived from redirect_url's origin).
backend_logout_url = https://keycloak.example.com/realms/example/protocol/openid-connect/logout

# Scope sent in the authorization request. Read from config, never hardcoded.
scope = "openid profile email"

# Claim name (in the ID token or userinfo response) that carries the user's
# groups. Stored in the session and exposed at GET /api/me.
oidc_groups_claim = groups

# Group-based access control: comma-separated list of allowed group names.
#   - Empty/missing (default): allow ALL authenticated users (backward compatible).
#   - Non-empty: the user must be in at least one listed group, else login is
#     denied with a clear "Access denied" page. If the IdP returns NO groups
#     claim at all, access is DENIED (fail closed). Denied attempts are logged
#     to the container logs ([auth] DENY user=... groups=... allowed_groups=...).
allowed_groups = Admins, DevOps, Infrastructure

# ---------------------------------------------------------------------------
# Trusted-network mode (optional)
#
# To disable authentication entirely, set the toggle above to "false" OR run
# the container with `OIDC_ENABLED=false`. This disables ALL access control —
# only use on trusted internal networks.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Hosts — each host is its own [section] for granular control over the
# connection transport and credentials. The section name is the host name.
#
# Mandatory keys:
#   connection_uri  libvirt URI, e.g. qemu+ssh://user@host/system
#                   or qemu+tcp://host/system
#   auth_type        one of: ssh_key | sasl | none  (always mandatory)
#
# Per auth_type:
#   ssh_key  (qemu+ssh) — key_file is OPTIONAL; if omitted, the default key
#                         from the mounted ~/.ssh is used. If set, the key is
#                         loaded into an in-process ssh-agent so both the
#                         libvirt connection and the VNC ssh tunnel use it.
#   sasl     (qemu+tcp) — username AND password are REQUIRED. If either is
#                         missing the app REFUSES TO START, naming this block.
#   none     (qemu+tcp) — plain, unauthenticated TCP. username/password are
#                         ignored even if present.
#
# Transport/auth consistency is enforced: qemu+ssh => ssh_key,
# qemu+tcp => sasl|none. A misconfigured block aborts startup (or, on
# POST /api/config/reload, returns 400 and keeps the previous config).
#
# Backward compatibility: a legacy [hosts] section (name = uri) is still
# accepted and treated as auth_type=ssh_key with the default key.
# ---------------------------------------------------------------------------

[node03]
connection_uri = qemu+ssh://192.168.1.110/system
auth_type = ssh_key
key_file = ~/.ssh/id_rsa          ; omit to use the default mapped key

[node02]
connection_uri = qemu+tcp://192.168.1.111/system
auth_type = sasl
username = admin
password = MySecretPassword123

[node04]
connection_uri = qemu+tcp://192.168.1.112/system
auth_type = none                   ; plain TCP; username/password ignored

# Legacy shorthand (still works, = ssh_key with the default key):
# [hosts]
# node01 = qemu+ssh://root@node01/system

# ---------------------------------------------------------------------------
# VNC console connection mode (global override for qemu+ssh hosts)
#
#   ssh     (default) — per-session `ssh -N -L` tunnel to the host (uses the
#                         host's key_file if set). Best when Webvirt is NOT on
#                         the same network as the KVM host (NAT/firewall).
#   direct            — skip the SSH tunnel, connect straight to <vnc host>:<port>.
#                         Only works if the VM's VNC is bound to a reachable
#                         address (0.0.0.0 or a host LAN IP), NOT 127.0.0.1.
#
# Note: qemu+tcp hosts ALWAYS use direct (no SSH credentials to tunnel with),
# regardless of this setting.
# ---------------------------------------------------------------------------
[vnc]
mode = ssh

